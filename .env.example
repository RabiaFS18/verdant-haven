# Copy to .env and fill in your own Supabase / Lovable Cloud project values.

# Browser (public) values
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=your-project-id

# Optional: your public site address (no trailing slash). Enables og:image and product structured data images.
VITE_SITE_URL=https://www.example.com

# Server-only values. Never prefix these with VITE_ and never commit them.
# Used by checkout and the newsletter form.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
